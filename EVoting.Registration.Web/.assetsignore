# Files in this folder that are NOT part of the website. Wrangler publishes everything in [assets] directory = "."
# except what is listed here: tests (stub server, sample users), tools, deployment docs and project files stay private.
.assetsignore
.git
.gitignore
wrangler.toml
package.json
package-lock.json
README.md
node_modules
tests
tools
docs
